from flask import Flask, request, Response
import numpy as np
import cv2
import boto3
from engine.gpu_attendance_engine import recognize_frame

app = Flask(__name__)

dynamodb = boto3.resource("dynamodb", region_name="ap-south-1")
attendance_table = dynamodb.Table("Attendance")


@app.route("/dashboard")
def dashboard():

    response = attendance_table.scan()
    records = response.get("Items", [])

    html = """
    <h1>Teacher Attendance Portal</h1>

    <div style="display:flex; gap:40px">

    <div>
    <h2>Attendance</h2>
    <table border=1>
    <tr>
    <th>Name</th>
    <th>Roll</th>
    <th>Date</th>
    </tr>
    """

    for r in records:

        html += f"<tr><td>{r.get('name')}</td><td>{r.get('roll')}</td><td>{r.get('date')}</td></tr>"

    html += """
    </table>
    </div>

    <div>
    <h2>Live Camera</h2>
    <img src="/video_feed" width="480">
    </div>

    </div>
    """

    return html


@app.route("/video_feed")
def video_feed():

    cap = cv2.VideoCapture("http://172.20.10.2:81/stream", cv2.CAP_FFMPEG)
    if not cap.isOpened():
        print("Camera connection

    def generate():

        while True:

            success, frame = cap.read()

            if not success:
                print("camera frame faailed")
                continue

            frame = recognize_frame(frame)

            ret, buffer = cv2.imencode('.jpg', frame)
            frame_bytes = buffer.tobytes()

            yield (b'--frame\r\n'
                   b'Content-Type: image/jpeg\r\n\r\n' +
                   frame_bytes +
                   b'\r\n')

    return Response(generate(),
                    mimetype='multipart/x-mixed-replace; boundary=frame')


app.run(host="0.0.0.0", port=5000)

