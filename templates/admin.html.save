  const teacherSel=document.getElementById('ses-teacher');
  const teacher_id=teacherSel.value;
  const teacher_name=teacherSel.options[teacherSel.selectedIndex]?.dataset.name||'';
  const room=document.getElementById('ses-room').value.trim();
  const batch=document.getElementById('ses-batch').value.trim();
  const startVal=document.getElementById('ses-start').value;
  const dur=parseInt(document.getElementById('ses-duration').value)||55;
  if(!subject){toast('Subject required','error');return;}
  if(!teacher_id){toast('Select a teacher','error');return;}
  if(!room){toast('Room required','error');return;}
  if(!batch){toast('Batch required','error');return;}
  if(!startVal){toast('Start time required','error');return;}
  const startTs=Math.floor(new Date(startVal).getTime()/1000);
  try{
    const res=await fetch('/api/sessions',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({subject,teacher_id,teacher_name,room,batch,start_ts:startTs,duration_mins:dur})});
    const data=await res.json();
    if(res.ok){toast('✓ Session scheduled: '+data.session_id);loadSessions();}
    else toast(data.error||'Failed','error');
  }catch(e){toast('Server error','error');}
}

async function loadSessions(){
  try{
    const res=await fetch('/api/sessions');
    const data=await res.json();
    const body=document.getElementById('sessions-body');
    if(!data.length){body.innerHTML='<tr><td colspan="8"><div class="empty">No sessions yet.</div></td></tr>';return;}
    body.innerHTML=data.map(s=>{
      const d=new Date(s.start_ts*1000);
      const dateStr=d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});
      const startStr=d.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});
      const endStr=new Date(s.end_ts*1000).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});
      return`<tr>
        <td><strong>${cap(s.subject||'')}</strong></td>
        <td>${cap(s.teacher||'')}</td>
        <td class="mono" style="color:var(--accent2)">${s.batch||'—'}</td>
        <td class="mono">${s.room||'—'}</td>
        <td class="mono">${dateStr}</td>
        <td class="mono">${startStr}–${endStr}</td>
        <td><span class="badge ${s.status||'active'}">${s.status||'active'}</span></td>
        <td><button class="btn btn-danger" style="padding:4px 10px;font-size:10px" onclick="deleteSession('${s.session_id}')">Delete</button></td>
      </tr>`;
    }).join('');
  }catch(e){}
}

async function deleteSession(id){
  if(!confirm('Delete this session?'))return;
  const res=await fetch('/api/sessions/'+id,{method:'DELETE'});
  if(res.ok){toast('✓ Deleted');loadSessions();}
}

// Camera
let capturedBlob=null;
function reloadFeed(){document.getElementById('esp-stream-img').src='/video_feed_annotated?t='+Date.now();}

async function captureFromServer(){
  const btn=document.getElementById('capture-btn');
  const status=document.getElementById('face-status');
  btn.disabled=true;btn.textContent='Capturing...';
  status.className='face-status checking';status.style.display='block';
  status.textContent='⏳ Capturing from ESP32...';
  try{
    const res=await fetch('/api/capture_frame');
    if(!res.ok)throw new Error('Capture failed: '+res.status);
    const blob=await res.blob();capturedBlob=blob;
    const url=URL.createObjectURL(blob);
    const img=document.getElementById('captured-img');
    img.src=url;img.style.display='block';
    document.getElementById('photo-placeholder').style.display='none';
    document.getElementById('photo-box').classList.add('has-photo');
    document.getElementById('retake-btn').style.display='inline-block';
    status.textContent='⏳ Checking for face...';
    const fd=new FormData();fd.append('photo',blob,'check.jpg');
    const cr=await fetch('/api/check_face',{method:'POST',body:fd});
    const cd=await cr.json();
    if(cd.face_detected){status.className='face-status ok';status.textContent=`✓ Face detected — ready to register`;}
    else{status.className='face-status fail';status.textContent='✗ No face — retake photo';}
  }catch(e){
    status.className='face-status fail';status.textContent='✗ '+e.message;
    toast('Capture failed','error');
  }finally{btn.disabled=false;btn.textContent='📸 CAPTURE';}
}

function retake(){
  capturedBlob=null;
  document.getElementById('captured-img').style.display='none';
  document.getElementById('captured-img').src='';
  document.getElementById('photo-placeholder').style.display='flex';
  document.getElementById('photo-box').classList.remove('has-photo');
  document.getElementById('face-status').style.display='none';
  document.getElementById('retake-btn').style.display='none';
}

// Register Student — email included
async function registerStudent(){
  const sid  =document.getElementById('s-id').value.trim();
  const name =document.getElementById('s-name').value.trim();
  const roll =document.getElementById('s-roll').value.trim();
  const batch=document.getElementById('s-batch').value.trim();
  const email=document.getElementById('s-email').value.trim();  // ← email
  if(!sid||!name||!roll||!batch){toast('Fill all required fields','error');return;}
  if(!capturedBlob){toast('Capture a photo first','error');return;}
  // Email is optional but recommended
  if(email && !email.includes('@')){toast('Enter a valid email address','error');return;}

  const btn=document.getElementById('reg-btn');
  const prog=document.getElementById('reg-progress');
  const fill=document.getElementById('prog-fill');
  const ptext=document.getElementById('prog-text');
  btn.disabled=true;btn.textContent='Processing...';
  prog.style.display='block';fill.style.width='30%';
  ptext.textContent='Extracting face embedding...';

  const fd=new FormData();
  fd.append('student_id',sid);
  fd.append('name',name);
  fd.append('roll',roll);
  fd.append('batch',batch);
  fd.append('email',email);       // ← email sent to server
  fd.append('photo',capturedBlob,`${sid}.jpg`);

  try{
    fill.style.width='70%';
    const res=await fetch('/api/register_student',{method:'POST',body:fd});
    const data=await res.json();
    fill.style.width='100%';
    if(res.ok){
      toast('✓ '+data.message+(email?' — email saved for notifications':''));
      // Reset all fields including email
      ['s-id','s-name','s-roll','s-batch','s-email'].forEach(id=>document.getElementById(id).value='');
      retake();loadStudents();
    }else toast(data.error||'Failed','error');
  }catch(e){toast('Server error','error');}
  finally{
    btn.disabled=false;btn.textContent='+ REGISTER STUDENT';
    setTimeout(()=>{prog.style.display='none';fill.style.width='0%';},1500);
  }
}

async function loadStudents(){
  try{
    const res=await fetch('/api/students');
    const data=await res.json();
    const body=document.getElementById('students-body');
    if(!data.length){body.innerHTML='<tr><td colspan="8"><div class="empty">No students yet.</div></td></tr>';return;}
    body.innerHTML=data.map(s=>{
      const hasEmb=s.embedding&&s.embedding.length>0;
      const initials=(s.name||'?').split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2);
      const emailBadge=s.email
        ?`<span style="color:var(--accent);font-size:10px;font-family:var(--mono)">✉ ${s.email}</span>`
        :`<span style="color:var(--muted);font-size:10px;font-family:var(--mono)">no email</span>`;
      return`<tr>
        <td><div class="student-initials">${initials}</div></td>
        <td><strong>${cap(s.name||'')}</strong></td>
        <td class="mono">${s.roll||'—'}</td>
        <td class="mono" style="color:var(--accent2)">${s.batch||'—'}</td>
        <td>${emailBadge}</td>
        <td class="mono">${s.student_id||'—'}</td>
        <td><span class="badge ${hasEmb?'active':'absent'}">${hasEmb?'✓ ready':'✗ missing'}</span></td>
        <td><button class="btn btn-danger" style="padding:4px 8px;font-size:10px" onclick="deleteStudent('${s.student_id}')">Del</button></td>
      </tr>`;
    }).join('');
  }catch(e){}
}

async function deleteStudent(id){
  if(!confirm('Delete this student?'))return;
  const res=await fetch('/api/delete_student/'+id,{method:'DELETE'});
  if(res.ok){toast('✓ Deleted');loadStudents();}
}

// Teachers
let teacherSubjects=[];
function addTag(){
  const input=document.getElementById('t-subj-input');
  const val=input.value.trim();
  if(!val||teacherSubjects.includes(val))return;
  teacherSubjects.push(val);input.value='';renderTags();
}
function removeTag(s){teacherSubjects=teacherSubjects.filter(x=>x!==s);renderTags();}
function renderTags(){
  document.getElementById('subj-tags').innerHTML=
    teacherSubjects.map(s=>`<div class="tag">${s}<span class="tag-remove" onclick="removeTag('${s}')">✕</span></div>`).join('');
}

async function registerTeacher(){
  const id=document.getElementById('t-id').value.trim();
  const name=document.getElementById('t-name').value.trim();
  const uname=document.getElementById('t-username').value.trim();
  const pwd=document.getElementById('t-password').value;
  const dept=document.getElementById('t-dept').value.trim();
  if(!id||!name||!uname||!pwd){toast('Fill all required fields','error');return;}
  try{
    const res=await fetch('/api/register_teacher',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({teacher_id:id,name,username:uname,password:pwd,department:dept,subjects:teacherSubjects})});
    const data=await res.json();
    if(res.ok){
      toast('✓ '+data.message);
      ['t-id','t-name','t-username','t-password','t-dept'].forEach(id=>document.getElementById(id).value='');
      teacherSubjects=[];renderTags();loadTeachers();loadTeacherDropdown();
    }else toast(data.error||'Failed','error');
  }catch(e){toast('Server error','error');}
}

async function loadTeachers(){
  try{
    const res=await fetch('/api/teachers');
    const data=await res.json();
    const body=document.getElementById('teachers-body');
    if(!data.length){body.innerHTML='<tr><td colspan="6"><div class="empty">No teachers yet.</div></td></tr>';return;}
    body.innerHTML=data.map((t,i)=>{
      const subjs=(t.subjects||[]).map(s=>`<span class="badge active" style="margin:1px">${s}</span>`).join('');
      return`<tr>
        <td class="mono">${i+1}</td>
        <td><strong>${cap(t.name||'')}</strong></td>
        <td class="mono">${t.username||'—'}</td>
        <td>${t.department||'—'}</td>
        <td>${subjs||'—'}</td>
        <td><button class="btn btn-danger" style="padding:4px 8px;font-size:10px" onclick="deleteTeacher('${t.teacher_id}')">Del</button></td>
      </tr>`;
    }).join('');
  }catch(e){}
}

async function deleteTeacher(id){
  if(!confirm('Delete?'))return;
  const res=await fetch('/api/delete_teacher/'+id,{method:'DELETE'});
  if(res.ok){toast('✓ Deleted');loadTeachers();}
}

async function loadAttendance(){
  try{
    const res=await fetch('/api/attendance');
    const data=await res.json();
    const body=document.getElementById('attendance-body');
    if(!data.length){body.innerHTML='<tr><td colspan="9"><div class="empty">No records.</div></td></tr>';return;}
    body.innerHTML=data.map((r,i)=>`<tr>
      <td class="mono">${i+1}</td>
      <td>${cap(r.name||'')}</td>
      <td class="mono">${r.roll||'—'}</td>
      <td class="mono" style="color:var(--accent2)">${r.batch||'—'}</td>
      <td>${r.subject||'—'}</td>
      <td class="mono">${r.room||'—'}</td>
      <td class="mono">${r.date||'—'}</td>
      <td class="mono">${r.windows_seen!==undefined?r.windows_seen+'/3':'—'}</td>
      <td><span class="badge ${r.status||'present'}">${r.status||'present'}</span></td>
    </tr>`).join('');
  }catch(e){}
}

// Init
loadSessions();
loadTeacherDropdown();
</script>
</body>
</html>
